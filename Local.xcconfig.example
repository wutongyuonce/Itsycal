// Copy to Local.xcconfig (gitignored). Shared by the app and widget targets.
// Source-only builds: pass CODE_SIGNING_ALLOWED=NO to xcodebuild.
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = NO

// To RUN the native widget, replace the settings above with your own values:
// DEVELOPMENT_TEAM = <your-team-id>
// CODE_SIGN_IDENTITY = Apple Development
// CODE_SIGN_STYLE = Automatic
// ENABLE_HARDENED_RUNTIME = YES
// WEEK_APP_GROUP = <your-team-id>.com.wutongyuonce.ItsycalWeek
//
// macOS permits team-prefixed App Groups without registering a group on the
// developer website. Both targets must use the same team and group. Xcode
// manages signing; no personal certificate, profile or team ID belongs in Git.
// The fallback group.com.wutongyuonce.ItsycalWeek only permits compilation and is
// not a promise that ad-hoc signed builds can access the shared container.
